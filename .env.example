# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan pernah commit .env.local.

# Project URL Supabase. Tanpa "/rest/v1/" dan tanpa "/" di akhir.
VITE_SUPABASE_URL=.env.local

# Publishable key (sb_publishable_...). Aman di frontend karena RLS aktif.
# Jangan isi dengan secret key (sb_secret_...) atau service role key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Catatan: GEMINI_API_KEY dan GEMINI_MODEL TIDAK ditaruh di sini.
# Keduanya diatur sebagai secret Supabase untuk Edge Function:
#   npx supabase secrets set GEMINI_API_KEY=...